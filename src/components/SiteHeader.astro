---
// Wordmark plus primary nav. The current section gets aria-current="page".
const links = [
	{ href: '/work/', label: 'Work' },
	{ href: '/notes/', label: 'Notes' },
	{ href: '/about/', label: 'About' },
	{ href: '/contact/', label: 'Contact' },
];

// Match /work/ and anything under it (e.g. /work/ronnie-bookbinder/).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
	<div class="wrap inner">
		<a class="wordmark" href="/">Phil Cifone</a>
		<nav aria-label="Primary">
			<ul role="list">
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: var(--hairline);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-3);
	}
	.wordmark {
		font-size: var(--step-1);
		color: var(--ink);
		text-decoration: none;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent);
	}
</style>
