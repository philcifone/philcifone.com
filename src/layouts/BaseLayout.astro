---
// Shared page shell: <head>, skip link, header, main, footer.
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ogImagePath, ogPages, ogSlug } from '../lib/og';
// The same files global.css loads, so Vite gives them the same hashed URLs.
import youngSerif from '@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url';
import courierPrime from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	// Path to this page's link-preview image. Defaults to the one built for
	// this URL in src/lib/og.ts, or the home page's if there isn't one.
	ogImage?: string;
}

const slug = ogSlug(Astro.url.pathname);
const {
	title,
	description = 'Phil Cifone — photographer and digital archivist. Archives, storage and websites for artists and cultural organizations.',
	ogImage = ogImagePath(slug in ogPages ? slug : 'index'),
} = Astro.props;

// "Work — Phil Cifone" on inner pages, just the name on the home page.
const fullTitle = title ? `${title} — Phil Cifone` : 'Phil Cifone';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<!-- Fetch the two everyday fonts early, so text doesn't reflow when they
		     swap in (Lighthouse counts that as layout shift). -->
		<link rel="preload" href={youngSerif} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={courierPrime} as="font" type="font/woff2" crossorigin />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Link previews (Open Graph; Mastodon, Slack, iMessage and others read these). -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Phil Cifone" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${title ?? 'Phil Cifone'}, on a card from philcifone.com`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main" class="wrap">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	main {
		flex: 1;
		padding-block: var(--space-5) var(--space-6);
	}
</style>
